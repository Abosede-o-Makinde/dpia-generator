**/service-account*.json

# Prisma local DBs
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Hosting / deploy link metadata (local only)
.vercel/
**/.vercel/

# IDE / OS
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.iml
.vscode/
.cursor/
*.swp
*~

