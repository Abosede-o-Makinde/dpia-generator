// ─────────────────────────────────────────────────────────────────────────────
// Aegis Privacy Platform — relational model
//
// Multi-tenancy: Organisation is the tenant root. Every tenant-scoped model
// carries organisationId; the Prisma client extension in src/prisma enforces
// scoping on every query, and Postgres RLS policies (see migrations/rls.sql)
// provide defence-in-depth.
//
// Soft deletes: deletedAt on user-facing aggregates. AuditLog and
// WorkflowEvent are append-only (no update/delete paths in the API).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  DPO
  PRIVACY_ENGINEER
  SECURITY_REVIEWER
  LEGAL_REVIEWER
  CONTRIBUTOR
  VIEWER
}

enum DpiaStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  LEGAL_REVIEW
  SECURITY_REVIEW
  DPO_APPROVAL
  EXECUTIVE_APPROVAL
  APPROVED
  IMPLEMENTED
  MONITORING
  REVIEW_DUE
  REJECTED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  ANALYSING
  MITIGATING
  MITIGATED
  ACCEPTED
  TRANSFERRED
  CLOSED
}

enum ControlStatus {
  RECOMMENDED
  PLANNED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
}

enum EvidenceType {
  POLICY
  CONTRACT
  SCREENSHOT
  ARCHITECTURE_DIAGRAM
  PENETRATION_TEST
  RISK_ASSESSMENT
  SECURITY_REPORT
  VENDOR_ASSESSMENT
  DPA
  OTHER
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  MFA_ENROLLED
  MFA_CHALLENGE
  TOKEN_ISSUED
  TOKEN_REVOKED
  STATUS_CHANGE
  APPROVE
  REJECT
  EXPORT
  UPLOAD
  DOWNLOAD
  AI_INVOCATION
  SCAN
  PERMISSION_CHANGE
}

enum ConnectorProvider {
  AWS
  AZURE
  GCP
  M365
  GITHUB
  GITLAB
  KUBERNETES
  TERRAFORM
  DOCKER
}

enum FindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ── Tenancy & identity ───────────────────────────────────────────────────────

model Organisation {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  industry  String?
  /// Org-level settings: risk scoring config overrides, branding, retention.
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships    Membership[]
  departments    Department[]
  projects       Project[]
  dpias          Dpia[]
  risks          Risk[]
  controls       Control[]
  evidence       Evidence[]
  auditLogs      AuditLog[]
  apiTokens      ApiToken[]
  connectors     Connector[]
  aiConversations AiConversation[]
  reportExports  ReportExport[]

  @@map("organisations")
}

model Department {
  id             String    @id @default(uuid())
  organisationId String
  name           String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  teams        Team[]
  projects     Project[]
  memberships  Membership[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("departments")
}

model Team {
  id           String    @id @default(uuid())
  departmentId String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  department  Department   @relation(fields: [departmentId], references: [id])
  memberships Membership[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@map("teams")
}

model Project {
  id             String    @id @default(uuid())
  organisationId String
  departmentId   String?
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  dpias        Dpia[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("projects")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  displayName   String
  passwordHash  String?
  /// AES-256-GCM encrypted TOTP secret (null until MFA enrolled).
  mfaSecretEnc  String?
  mfaEnabled    Boolean   @default(false)
  /// Argon2 hashes of one-time recovery codes.
  mfaRecovery   String[]  @default([])
  /// Subject from external IdP when provisioned via SSO.
  ssoSubject    String?   @unique
  ssoProvider   String?
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  memberships Membership[]
  sessions    Session[]
  credentials WebAuthnCredential[]
  apiTokens   ApiToken[]

  @@map("users")
}

model Membership {
  id             String    @id @default(uuid())
  organisationId String
  userId         String
  role           Role      @default(CONTRIBUTOR)
  departmentId   String?
  teamId         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId])
  @@map("memberships")
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  /// SHA-256 hash of the refresh token; raw token never stored.
  tokenHash  String    @unique
  /// Rotation chain id — reuse of a rotated token revokes the chain.
  familyId   String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  transports   String[] @default([])
  label        String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("webauthn_credentials")
}

model ApiToken {
  id             String    @id @default(uuid())
  organisationId String
  userId         String
  name           String
  /// SHA-256 hash; raw token shown once at creation.
  tokenHash      String    @unique
  scopes         String[]  @default([])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organisationId])
  @@index([userId])
  @@map("api_tokens")
}

// ── Questionnaire & DPIA ─────────────────────────────────────────────────────

model QuestionnaireTemplate {
  id        String   @id @default(uuid())
  key       String
  version   Int
  name      String
  /// Full template document (sections/questions/conditions) — see @aegis/shared.
  document  Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  dpias Dpia[]

  @@unique([key, version])
  @@map("questionnaire_templates")
}

model Dpia {
  id              String     @id @default(uuid())
  organisationId  String
  projectId       String?
  templateId      String
  reference       String // human ref e.g. DPIA-2026-0042, unique per org
  title           String
  description     String?
  status          DpiaStatus @default(DRAFT)
  /// Answer map keyed by question key.
  answers         Json       @default("{}")
  completeness    Int        @default(0)
  /// Result of the AI screening classification, if run.
  classification  Json?
  /// Data flow diagram (nodes/edges) + detected findings.
  dataFlow        Json?
  ownerId         String
  dueDate         DateTime?
  nextReviewAt    DateTime?
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organisation Organisation          @relation(fields: [organisationId], references: [id])
  project      Project?              @relation(fields: [projectId], references: [id])
  template     QuestionnaireTemplate @relation(fields: [templateId], references: [id])

  risks          Risk[]
  comments       DpiaComment[]
  approvals      DpiaApproval[]
  workflowEvents WorkflowEvent[]
  evidenceLinks  DpiaEvidence[]
  controlLinks   DpiaControl[]
  reportExports  ReportExport[]

  @@unique([organisationId, reference])
  @@index([organisationId, status])
  @@index([organisationId, updatedAt])
  @@map("dpias")
}

model DpiaComment {
  id          String    @id @default(uuid())
  dpiaId      String
  authorId    String
  /// Anchors the comment to a question when set.
  questionKey String?
  body        String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  dpia Dpia @relation(fields: [dpiaId], references: [id])

  @@index([dpiaId])
  @@map("dpia_comments")
}

model DpiaApproval {
  id         String    @id @default(uuid())
  dpiaId     String
  stage      DpiaStatus
  approverId String
  decision   String // APPROVED | REJECTED | CHANGES_REQUESTED
  comment    String?
  decidedAt  DateTime  @default(now())

  dpia Dpia @relation(fields: [dpiaId], references: [id])

  @@index([dpiaId])
  @@map("dpia_approvals")
}

/// Append-only history of workflow transitions (immutable).
model WorkflowEvent {
  id         String     @id @default(uuid())
  dpiaId     String
  fromStatus DpiaStatus
  toStatus   DpiaStatus
  actorId    String
  comment    String?
  createdAt  DateTime   @default(now())

  dpia Dpia @relation(fields: [dpiaId], references: [id])

  @@index([dpiaId, createdAt])
  @@map("workflow_events")
}

// ── Risk & controls ──────────────────────────────────────────────────────────

model Risk {
  id             String     @id @default(uuid())
  organisationId String
  dpiaId         String?
  /// Rule key when auto-generated by the risk engine; null for manual risks.
  ruleKey        String?
  title          String
  description    String
  category       String     @default("privacy")
  likelihood     Int
  impact         Int
  inherentScore  Float
  residualScore  Float
  level          RiskLevel
  residualLevel  RiskLevel
  status         RiskStatus @default(IDENTIFIED)
  treatment      String?
  ownerId        String?
  dueDate        DateTime?
  references     String[]   @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organisation Organisation  @relation(fields: [organisationId], references: [id])
  dpia         Dpia?         @relation(fields: [dpiaId], references: [id])
  controlLinks RiskControl[]

  @@index([organisationId, level])
  @@index([dpiaId])
  @@map("risks")
}

/// Control catalogue. Global controls have organisationId = null; orgs can add
/// their own. Seeded from the built-in library (see prisma/seed).
model Control {
  id             String   @id @default(uuid())
  organisationId String?
  key            String
  name           String
  description    String
  category       String
  /// Implementation guidance (markdown).
  guidance       String?
  /// 0–1 default effectiveness against mapped risks when implemented.
  effectiveness  Float    @default(0.5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organisation Organisation?    @relation(fields: [organisationId], references: [id])
  mappings     ControlMapping[]
  riskLinks    RiskControl[]
  dpiaLinks    DpiaControl[]
  evidence     ControlEvidence[]

  @@unique([organisationId, key])
  @@index([organisationId])
  @@map("controls")
}

/// Maps a control to a framework requirement (ISO 27001 A.8.24, GDPR Art. 32…).
model ControlMapping {
  id        String @id @default(uuid())
  controlId String
  framework String // FrameworkId from @aegis/shared
  reference String // e.g. "A.8.24", "Art. 32(1)(a)", "PR.DS-1"
  title     String

  control Control @relation(fields: [controlId], references: [id])

  @@unique([controlId, framework, reference])
  @@index([framework])
  @@map("control_mappings")
}

model RiskControl {
  id            String        @id @default(uuid())
  riskId        String
  controlId     String
  status        ControlStatus @default(RECOMMENDED)
  /// Effectiveness override for this specific application (0–1).
  effectiveness Float?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  risk    Risk    @relation(fields: [riskId], references: [id])
  control Control @relation(fields: [controlId], references: [id])

  @@unique([riskId, controlId])
  @@map("risk_controls")
}

model DpiaControl {
  id        String        @id @default(uuid())
  dpiaId    String
  controlId String
  status    ControlStatus @default(RECOMMENDED)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  dpia    Dpia    @relation(fields: [dpiaId], references: [id])
  control Control @relation(fields: [controlId], references: [id])

  @@unique([dpiaId, controlId])
  @@map("dpia_controls")
}

// ── Evidence ─────────────────────────────────────────────────────────────────

model Evidence {
  id             String       @id @default(uuid())
  organisationId String
  type           EvidenceType @default(OTHER)
  filename       String
  contentType    String
  sizeBytes      Int
  /// Object storage key (S3/Azure Blob).
  storageKey     String       @unique
  sha256         String
  uploadedById   String
  description    String?
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  organisation Organisation      @relation(fields: [organisationId], references: [id])
  dpiaLinks    DpiaEvidence[]
  controlLinks ControlEvidence[]

  @@index([organisationId])
  @@map("evidence")
}

model DpiaEvidence {
  id         String @id @default(uuid())
  dpiaId     String
  evidenceId String

  dpia     Dpia     @relation(fields: [dpiaId], references: [id])
  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@unique([dpiaId, evidenceId])
  @@map("dpia_evidence")
}

model ControlEvidence {
  id         String @id @default(uuid())
  controlId  String
  evidenceId String

  control  Control  @relation(fields: [controlId], references: [id])
  evidence Evidence @relation(fields: [evidenceId], references: [id])

  @@unique([controlId, evidenceId])
  @@map("control_evidence")
}

// ── Audit ────────────────────────────────────────────────────────────────────

/// Append-only audit trail. No update/delete API exists for this table and the
/// DB role used by the app is denied UPDATE/DELETE on it (see rls.sql).
model AuditLog {
  id             String      @id @default(uuid())
  organisationId String?
  actorId        String?
  actorType      String      @default("user") // user | api_token | system
  action         AuditAction
  entityType     String
  entityId       String?
  ip             String?
  userAgent      String?
  requestId      String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── Cloud scanner ────────────────────────────────────────────────────────────

model Connector {
  id             String            @id @default(uuid())
  organisationId String
  provider       ConnectorProvider
  name           String
  /// AES-256-GCM encrypted connection config (roles ARNs, tenant ids, tokens).
  configEnc      String
  status         String            @default("ACTIVE")
  lastScanAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  scans        Scan[]

  @@index([organisationId])
  @@map("connectors")
}

model Scan {
  id          String     @id @default(uuid())
  connectorId String
  status      ScanStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?
  createdAt   DateTime   @default(now())

  connector Connector     @relation(fields: [connectorId], references: [id])
  findings  ScanFinding[]

  @@index([connectorId])
  @@map("scans")
}

model ScanFinding {
  id          String          @id @default(uuid())
  scanId      String
  severity    FindingSeverity
  category    String // encryption | iam | public-exposure | secrets | logging | mfa | network | backup
  resourceId  String
  title       String
  description String
  remediation String
  status      FindingStatus   @default(OPEN)
  /// Question keys this finding can pre-populate, with suggested values.
  dpiaHints   Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  scan Scan @relation(fields: [scanId], references: [id])

  @@index([scanId, severity])
  @@map("scan_findings")
}

// ── AI assistant ─────────────────────────────────────────────────────────────

model AiConversation {
  id             String   @id @default(uuid())
  organisationId String
  userId         String
  dpiaId         String?
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id])
  messages     AiMessage[]

  @@index([organisationId, userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  /// Model, token usage, tool calls, citations.
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ── Reporting ────────────────────────────────────────────────────────────────

model ReportExport {
  id             String   @id @default(uuid())
  organisationId String
  dpiaId         String?
  template       String // dpia-full | board | dpo | ico | audit | executive-summary
  format         String // pdf | docx | html | md | csv | xlsx | json
  storageKey     String?
  generatedById  String
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id])
  dpia         Dpia?        @relation(fields: [dpiaId], references: [id])

  @@index([organisationId, createdAt])
  @@map("report_exports")
}
