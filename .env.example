# ── Shieldwise Platform — environment template ──────────────────────────────
# Copy to .env and fill in values. NEVER commit real secrets.

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://shieldwise:shieldwise_dev_password@localhost:5432/shieldwise?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ (optional in dev — events fall back to in-process bus)
RABBITMQ_URL=amqp://shieldwise:shieldwise_dev_password@localhost:5672

# Elasticsearch (optional — search falls back to Postgres full-text)
ELASTICSEARCH_URL=

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
MFA_ENCRYPTION_KEY=change-me-32-bytes-base64

# SSO / OIDC (optional; any OIDC-compliant IdP: Keycloak, Entra ID, Okta, Google)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# WebAuthn / passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Shieldwise Privacy Platform
WEBAUTHN_ORIGIN=http://localhost:3000

# Object storage (S3-compatible; MinIO in dev)
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# S3_REGION=auto, and S3_SERVER_SIDE_ENCRYPTION= (empty — R2 rejects the header)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=shieldwise-evidence
S3_ACCESS_KEY_ID=shieldwise
S3_SECRET_ACCESS_KEY=shieldwise_dev_password
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256   # AES256 | aws:kms | empty

# AI service
AI_SERVICE_TOKEN=change-me
AI_PROVIDER=anthropic            # anthropic | openai | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# RAG (privacy guidance retrieval)
RAG_BACKEND=bm25                 # bm25 | pgvector
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
