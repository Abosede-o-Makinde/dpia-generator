# ── Shieldwise — environment template ──────────────────────────────────
# Copy to .env and fill in values. NEVER commit real secrets.
# Generate secrets: openssl rand -base64 48

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
AI_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (Render: paste the managed DATABASE_URL)
DATABASE_URL=postgresql://shieldwise:shieldwise_dev_password@localhost:5432/shieldwise?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-at-least-16-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
MFA_ENCRYPTION_KEY=change-me-at-least-16-chars
ALLOW_SIGNUP=true

# WebAuthn (set to your real domain in production)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Shieldwise Privacy Platform
WEBAUTHN_ORIGIN=http://localhost:3000

# Object storage — MinIO (Compose) or Cloudflare R2 (production)
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#     S3_REGION=auto  S3_SERVER_SIDE_ENCRYPTION= (leave empty)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=shieldwise-evidence
S3_ACCESS_KEY_ID=shieldwise
S3_SECRET_ACCESS_KEY=shieldwise_dev_password
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256

# AI (API ↔ AI service). Optional for core DPIA flows.
AI_SERVICE_TOKEN=change-me
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Or: AI_PROVIDER=openai + OPENAI_API_KEY=...
# Or: AI_PROVIDER=local + LOCAL_LLM_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

LOG_LEVEL=info
